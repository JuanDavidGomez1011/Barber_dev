# ---- Base de datos (Supabase) ----
# Supabase → tu proyecto → botón "Connect" (arriba) → pestaña "ORMs" o "Connection string".
# Reemplaza [YOUR-PASSWORD] por la contraseña de la base de datos que elegiste al crear el proyecto.

# Pooler en modo transacción (puerto 6543). Lo usa la app (local y en Vercel).
DATABASE_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres"

# Pooler en modo sesión (puerto 5432). Lo usan las migraciones y el seed.
DIRECT_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---- Seed ----
# Contraseña de los usuarios de ejemplo que crea `npm run db:seed` (solo desarrollo).
SEED_PASSWORD="barberia123"

# ---- Sesiones (login de barberos y admin) ----
# Mínimo 32 caracteres. Genera uno: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# ---- Notificaciones por WhatsApp ----
# URL pública del sitio (para los enlaces de los mensajes). En Vercel se deduce sola si no la defines.
APP_URL="http://localhost:3000"
# Protege /api/cron/notifications. Genera uno largo y aleatorio (mismo valor en Vercel y en el cron).
CRON_SECRET=""
# Clave para cifrar el token del enlace de gestión (opcional; si falta se usa SESSION_SECRET).
# Si la cambias, los recordatorios de citas ya agendadas saldrán sin enlace.
TOKEN_SECRET=""

# Proveedor: console (simulado, por defecto) | twilio | whatsapp-cloud
NOTIFICATIONS_PROVIDER="console"
# Solo pruebas: hace fallar al azar una parte de los envíos simulados (0 a 1), para ver los reintentos.
# NOTIFICATIONS_SIMULATE_FAILURE_RATE="0.3"

# Twilio (NOTIFICATIONS_PROVIDER=twilio)
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_WHATSAPP_FROM="+14155238886"
# TWILIO_CONTENT_SID_CONFIRMATION=""   # plantillas aprobadas (opcional por tipo)

# WhatsApp Business Cloud API de Meta (NOTIFICATIONS_PROVIDER=whatsapp-cloud)
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_API_VERSION="v23.0"
# WHATSAPP_TEMPLATE_CONFIRMATION="barberia_confirmacion"
